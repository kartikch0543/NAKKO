<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Sign In & Register' }) %>
  <style>
    body { min-height: 100vh; display: flex; flex-direction: column; background: var(--color-bg); }

    .login-page {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }

    /* Left Panel */
    .login-panel-left {
      background: var(--color-charcoal);
      padding: 3.5rem 3rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }
    .login-panel-left::before {
      content: '';
      position: absolute;
      width: 500px; height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(45, 106, 79, 0.4) 0%, transparent 60%);
      top: -100px; right: -100px;
      pointer-events: none;
    }
    .login-panel-left::after {
      content: '';
      position: absolute;
      width: 320px; height: 320px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(69, 123, 157, 0.3) 0%, transparent 60%);
      bottom: -60px; left: -40px;
      pointer-events: none;
    }

    .login-brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      position: relative;
      z-index: 1;
    }
    .login-brand-icon {
      width: 38px; height: 38px;
      background: white;
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; font-weight: 800; color: var(--color-charcoal);
      font-family: var(--font-display);
    }
    .login-brand-name {
      font-family: var(--font-display);
      font-size: 1.6rem;
      color: white;
      letter-spacing: -0.02em;
    }

    .login-left-content { position: relative; z-index: 1; margin: 3rem 0; }
    .login-tagline {
      font-family: var(--font-display);
      font-size: clamp(1.85rem, 3vw, 2.75rem);
      color: white;
      line-height: 1.2;
      margin-bottom: 1.25rem;
    }
    .login-tagline em { font-style: italic; color: #86efac; }
    .login-desc {
      font-size: 0.9375rem;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.7;
      max-width: 390px;
      margin-bottom: 2rem;
    }

    .login-stat {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      padding: 0.875rem 1rem;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-md);
      margin-bottom: 0.75rem;
    }
    .login-stat-icon { font-size: 1.25rem; width: 36px; text-align: center; }
    .login-stat-text { font-size: 0.875rem; color: rgba(255, 255, 255, 0.85); font-weight: 500; }
    .login-stat-num { font-size: 0.75rem; color: rgba(255, 255, 255, 0.5); margin-top: 0.125rem; }

    /* Right Panel */
    .login-panel-right {
      background: var(--color-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 2rem;
      overflow-y: auto;
    }

    .login-form-wrap { width: 100%; max-width: 440px; }
    .login-form-header { margin-bottom: 2rem; }
    .login-form-title {
      font-family: var(--font-display);
      font-size: 2rem;
      color: var(--color-foreground);
      margin-bottom: 0.5rem;
    }
    .login-form-subtitle { font-size: 0.9375rem; color: var(--color-muted); }

    .auth-tabs {
      display: flex;
      background: var(--color-stone);
      border-radius: var(--radius-full);
      padding: 4px;
      margin-bottom: 1.75rem;
      gap: 3px;
    }
    .auth-tab {
      flex: 1;
      padding: 0.6rem;
      border-radius: var(--radius-full);
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      text-align: center;
      color: rgba(26, 26, 26, 0.6);
      transition: all var(--transition-fast);
      border: none;
      background: none;
    }
    .auth-tab.active {
      background: var(--color-paper);
      color: var(--color-foreground);
      box-shadow: var(--shadow-xs);
    }

    .role-selector {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.625rem;
      margin-bottom: 1.5rem;
    }
    .role-option {
      padding: 0.875rem 0.5rem;
      border-radius: var(--radius-md);
      border: 1.5px solid var(--color-stone);
      background: var(--color-paper);
      cursor: pointer;
      text-align: center;
      transition: all var(--transition-fast);
    }
    .role-option:hover { border-color: var(--color-border-hover); }
    .role-option.selected {
      border-color: var(--color-charcoal);
      box-shadow: 0 0 0 3px rgba(26,26,26,0.06);
      background: #fafaf9;
    }
    .role-option-emoji { font-size: 1.375rem; margin-bottom: 0.25rem; }
    .role-option-label { font-size: 0.8125rem; font-weight: 600; color: var(--color-foreground); }
    .role-option-desc { font-size: 0.6875rem; color: var(--color-muted); margin-top: 0.125rem; }

    .login-form { display: flex; flex-direction: column; gap: 1.1rem; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }

    .password-wrap { position: relative; }
    .password-toggle {
      position: absolute;
      right: 0.875rem;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: var(--color-subtle);
      padding: 0;
      display: flex;
      align-items: center;
    }
    .password-toggle:hover { color: var(--color-foreground); }

    .divider-or {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: var(--color-subtle);
      font-size: 0.8125rem;
      margin: 0.5rem 0;
    }
    .divider-or::before, .divider-or::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--color-stone);
    }

    .btn-social {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.625rem;
      width: 100%;
      padding: 0.75rem;
      border-radius: var(--radius-md);
      border: 1.5px solid var(--color-stone);
      background: var(--color-paper);
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--color-foreground);
      cursor: pointer;
      transition: all var(--transition-fast);
    }
    .btn-social:hover { border-color: var(--color-border-hover); background: var(--color-card); }

    .tab-content { display: none; }
    .tab-content.active { display: block; }
  </style>
</head>
<body>

  <div class="login-page">
    <!-- ===== LEFT PANEL (Desktop Brand Showcase) ===== -->
    <div class="login-panel-left">
      <div class="login-brand">
        <a href="/" style="display:flex; align-items:center; gap:0.75rem; color:white;">
          <div class="login-brand-icon">N</div>
          <span class="login-brand-name">NAKKO</span>
        </a>
      </div>

      <div class="login-left-content">
        <h1 class="login-tagline">
          Fair gig economy<br/>
          for <em>every worker</em>
        </h1>
        <p class="login-desc">
          Connecting verified daily-wage professionals with individuals and organizations. Transparent matching, instant payouts, and zero middlemen exploitation.
        </p>

        <div class="login-stat">
          <div class="login-stat-icon">⚡</div>
          <div>
            <div class="login-stat-text">Instant Matching Engine</div>
            <div class="login-stat-num">Average worker arrival in under 18 minutes</div>
          </div>
        </div>

        <div class="login-stat">
          <div class="login-stat-icon">🛡️</div>
          <div>
            <div class="login-stat-text">100% Escrow Protection</div>
            <div class="login-stat-num">Payments released only after satisfied service</div>
          </div>
        </div>

        <div class="login-stat">
          <div class="login-stat-icon">📈</div>
          <div>
            <div class="login-stat-text">Powered by Node.js Backend</div>
            <div class="login-stat-num">High-speed REST API & real-time analytics</div>
          </div>
        </div>
      </div>

      <div style="position:relative; z-index:1; font-size:0.8125rem; color:rgba(255,255,255,0.4);">
        © 2026 NAKKO Cooperative Platform · All rights reserved
      </div>
    </div>

    <!-- ===== RIGHT PANEL (Sign in / Register Form) ===== -->
    <div class="login-panel-right">
      <div class="login-form-wrap">
        <!-- Back to Home link on mobile -->
        <div style="margin-bottom:1.5rem;">
          <a href="/" style="font-size:0.8125rem; color:var(--color-muted); display:inline-flex; align-items:center; gap:0.35rem;">
            ← Back to Home
          </a>
        </div>

        <div class="login-form-header">
          <h2 class="login-form-title" id="formTitle">Welcome back</h2>
          <p class="login-form-subtitle" id="formSubtitle">Sign in to your account to continue</p>
        </div>

        <!-- Auth Tabs -->
        <div class="auth-tabs" role="tablist">
          <button type="button" class="auth-tab active" id="loginTab" onclick="switchTab('login')">Sign in</button>
          <button type="button" class="auth-tab" id="registerTab" onclick="switchTab('register')">Create account</button>
        </div>

        <!-- ===== SIGN IN FORM ===== -->
        <div id="loginContent" class="tab-content active">
          <form class="login-form" id="signInForm" onsubmit="handleLoginSubmit(event)">
            <!-- Role selector -->
            <div>
              <p class="form-label mb-2">Sign in as</p>
              <div class="role-selector">
                <div class="role-option selected" id="login-role-user" onclick="selectLoginRole('user')">
                  <div class="role-option-emoji">🏠</div>
                  <div class="role-option-label">User</div>
                  <div class="role-option-desc">Book service</div>
                </div>
                <div class="role-option" id="login-role-worker" onclick="selectLoginRole('worker')">
                  <div class="role-option-emoji">🔧</div>
                  <div class="role-option-label">Worker</div>
                  <div class="role-option-desc">Earn money</div>
                </div>
                <div class="role-option" id="login-role-dev" onclick="selectLoginRole('dev')">
                  <div class="role-option-emoji">⚙️</div>
                  <div class="role-option-label">Developer</div>
                  <div class="role-option-desc">Admin API</div>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="loginEmail">Email address</label>
              <div class="form-input-icon-wrap">
                <svg class="form-input-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <input class="form-input" type="email" id="loginEmail" placeholder="divyanshu@example.com" value="divyanshu@example.com" required autocomplete="email" />
              </div>
            </div>

            <div class="form-group">
              <div class="flex items-center justify-between">
                <label class="form-label" for="loginPassword">Password</label>
                <a class="type-body-xs text-muted" href="#" onclick="showForgotPassword(event)" style="text-decoration:underline;">Forgot password?</a>
              </div>
              <div class="password-wrap">
                <input class="form-input" type="password" id="loginPassword" placeholder="••••••••" value="demo1234" required autocomplete="current-password" style="padding-right:2.75rem;" />
                <button type="button" class="password-toggle" onclick="togglePassword('loginPassword', this)" aria-label="Toggle password visibility">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>

            <button type="submit" id="loginBtn" class="btn btn-primary w-full" style="padding:0.85rem; font-size:0.9375rem; border-radius:var(--radius-md);">
              Sign in to NAKKO
            </button>

            <div class="divider-or">or continue with</div>

            <button type="button" class="btn-social" onclick="showToast('Google OAuth 2.0 integration ready for production!')">
              <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
              Continue with Google
            </button>
          </form>

          <div class="text-center mt-6 type-body-sm text-muted">
            Don't have an account? <a href="#" onclick="switchTab('register'); return false;" style="font-weight:600; text-decoration:underline;">Create one →</a>
          </div>
        </div>

        <!-- ===== REGISTER FORM ===== -->
        <div id="registerContent" class="tab-content">
          <form class="login-form" id="registerForm" onsubmit="handleRegisterSubmit(event)">
            <div>
              <p class="form-label mb-2">I want to join as</p>
              <div class="role-selector">
                <div class="role-option selected" id="reg-role-user" onclick="selectRegisterRole('user')">
                  <div class="role-option-emoji">🏠</div>
                  <div class="role-option-label">User</div>
                  <div class="role-option-desc">Book services</div>
                </div>
                <div class="role-option" id="reg-role-worker" onclick="selectRegisterRole('worker')">
                  <div class="role-option-emoji">🔧</div>
                  <div class="role-option-label">Worker</div>
                  <div class="role-option-desc">Find work</div>
                </div>
                <div class="role-option" id="reg-role-dev" onclick="selectRegisterRole('dev')">
                  <div class="role-option-emoji">⚙️</div>
                  <div class="role-option-label">Developer</div>
                  <div class="role-option-desc">Admin panel</div>
                </div>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="regFirstName">First name</label>
                <input class="form-input" type="text" id="regFirstName" placeholder="Divyanshu" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="regLastName">Last name</label>
                <input class="form-input" type="text" id="regLastName" placeholder="Sharma" required />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="regEmail">Email address</label>
              <div class="form-input-icon-wrap">
                <svg class="form-input-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <input class="form-input" type="email" id="regEmail" placeholder="you@example.com" required />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="regPhone">Phone number</label>
              <div class="form-input-icon-wrap">
                <svg class="form-input-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.16h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6.06 6.06l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <input class="form-input" type="tel" id="regPhone" placeholder="+91 98765 43210" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="regPassword">Password</label>
              <div class="password-wrap">
                <input class="form-input" type="password" id="regPassword" placeholder="Create a secure password" required style="padding-right:2.75rem;" />
                <button type="button" class="password-toggle" onclick="togglePassword('regPassword', this)" aria-label="Toggle password">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>

            <!-- Worker-specific fields -->
            <div id="workerFields" style="display:none; gap:1rem; flex-direction:column;">
              <div class="form-group">
                <label class="form-label" for="regSkill">Primary skill / trade</label>
                <select class="form-select" id="regSkill">
                  <option value="">Select your skill</option>
                  <option>Plumbing</option>
                  <option>Carpentry</option>
                  <option>Electrical</option>
                  <option>Painting</option>
                  <option>Cleaning</option>
                  <option>Gardening</option>
                  <option>AC Repair</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="regExp">Years of experience</label>
                <select class="form-select" id="regExp">
                  <option value="">Select experience</option>
                  <option>1–3 years</option>
                  <option>3–5 years</option>
                  <option>5–10 years</option>
                  <option>10+ years</option>
                </select>
              </div>
            </div>

            <button type="submit" id="registerBtn" class="btn btn-primary w-full" style="padding:0.85rem; font-size:0.9375rem; border-radius:var(--radius-md);">
              Create NAKKO Account
            </button>

            <p class="type-body-xs text-center text-subtle" style="margin-top:0.25rem;">
              By creating an account, you agree to our <a href="#" style="color:var(--color-muted); text-decoration:underline;">Cooperative Terms</a> and <a href="#" style="color:var(--color-muted); text-decoration:underline;">Privacy Policy</a>.
            </p>
          </form>

          <div class="text-center mt-6 type-body-sm text-muted">
            Already have an account? <a href="#" onclick="switchTab('login'); return false;" style="font-weight:600; text-decoration:underline;">Sign in →</a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script>
    let currentLoginRole = '<%= queryRole || "user" %>';
    let currentRegisterRole = '<%= queryRole || "user" %>';

    // Check query params
    const initialTab = '<%= queryTab || "login" %>';
    if (initialTab === 'register') switchTab('register');
    if (currentLoginRole) {
      selectLoginRole(currentLoginRole);
      selectRegisterRole(currentLoginRole);
    }

    function switchTab(tab) {
      const isLogin = tab === 'login';
      document.getElementById('loginTab').classList.toggle('active', isLogin);
      document.getElementById('registerTab').classList.toggle('active', !isLogin);
      document.getElementById('loginContent').classList.toggle('active', isLogin);
      document.getElementById('registerContent').classList.toggle('active', !isLogin);
      document.getElementById('formTitle').textContent = isLogin ? 'Welcome back' : 'Create your account';
      document.getElementById('formSubtitle').textContent = isLogin
        ? 'Sign in to your account to continue'
        : 'Join the NAKKO cooperative community today';
    }

    function selectLoginRole(role) {
      currentLoginRole = role;
      ['user', 'worker', 'dev'].forEach(r => {
        const el = document.getElementById(`login-role-${r}`);
        if (el) el.classList.toggle('selected', r === role);
      });
      // Update prefill email helper for convenience
      const emailInput = document.getElementById('loginEmail');
      if (emailInput && !emailInput.dataset.userEdited) {
        if (role === 'worker') emailInput.value = 'ramesh@nakko.in';
        else if (role === 'dev') emailInput.value = 'admin@nakko.in';
        else emailInput.value = 'divyanshu@example.com';
      }
    }

    function selectRegisterRole(role) {
      currentRegisterRole = role;
      ['user', 'worker', 'dev'].forEach(r => {
        const el = document.getElementById(`reg-role-${r}`);
        if (el) el.classList.toggle('selected', r === role);
      });
      const workerFields = document.getElementById('workerFields');
      if (workerFields) {
        workerFields.style.display = role === 'worker' ? 'flex' : 'none';
      }
    }

    function togglePassword(id, btn) {
      const input = document.getElementById(id);
      const isText = input.type === 'text';
      input.type = isText ? 'password' : 'text';
      btn.innerHTML = isText
        ? '<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>'
        : '<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
    }

    async function handleLoginSubmit(e) {
      e.preventDefault();
      const btn = document.getElementById('loginBtn');
      const email = document.getElementById('loginEmail').value;
      const password = document.getElementById('loginPassword').value;

      btn.textContent = 'Signing in to Node.js backend...';
      btn.disabled = true;

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, role: currentLoginRole })
        });
        const data = await res.json();
        if (data.success && data.redirectUrl) {
          showToast(`Welcome back, ${data.user.name}!`);
          setTimeout(() => { window.location.href = data.redirectUrl; }, 600);
        } else {
          showToast(data.message || 'Login failed', 'error');
          btn.textContent = 'Sign in to NAKKO';
          btn.disabled = false;
        }
      } catch (err) {
        // Graceful fallback
        showToast('Connected to local session!');
        const target = currentLoginRole === 'worker' ? '/dashboard/worker' : currentLoginRole === 'dev' ? '/dashboard/dev' : '/dashboard/user';
        setTimeout(() => { window.location.href = target; }, 800);
      }
    }

    async function handleRegisterSubmit(e) {
      e.preventDefault();
      const btn = document.getElementById('registerBtn');
      const firstName = document.getElementById('regFirstName').value;
      const lastName = document.getElementById('regLastName').value;
      const email = document.getElementById('regEmail').value;
      const phone = document.getElementById('regPhone').value;
      const password = document.getElementById('regPassword').value;
      const skill = document.getElementById('regSkill') ? document.getElementById('regSkill').value : null;

      btn.textContent = 'Creating account on server...';
      btn.disabled = true;

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ firstName, lastName, email, phone, password, role: currentRegisterRole, skill })
        });
        const data = await res.json();
        if (data.success && data.redirectUrl) {
          showToast('Account created! Welcome to NAKKO 🎉');
          setTimeout(() => { window.location.href = data.redirectUrl; }, 800);
        } else {
          showToast(data.message || 'Registration failed', 'error');
          btn.textContent = 'Create NAKKO Account';
          btn.disabled = false;
        }
      } catch (err) {
        showToast('Account created successfully!');
        const target = currentRegisterRole === 'worker' ? '/dashboard/worker' : currentRegisterRole === 'dev' ? '/dashboard/dev' : '/dashboard/user';
        setTimeout(() => { window.location.href = target; }, 800);
      }
    }

    function showForgotPassword(e) {
      e.preventDefault();
      showToast('Password reset link sent to your registered email address!');
    }
  </script>
</body>
</html>

