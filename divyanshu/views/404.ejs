<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Page Not Found (404)' }) %>
  <style>
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-align: center;
    }
    .not-found-wrap {
      padding: 6rem 1.5rem;
      max-width: 540px;
      margin: auto;
    }
  </style>
</head>
<body>
  <%- include('partials/nav') %>

  <div class="not-found-wrap">
    <div style="font-size: 4rem; margin-bottom: 1rem;">🔍</div>
    <h1 class="type-h1 mb-2">404</h1>
    <h2 class="type-h2 mb-4">Page Not Found</h2>
    <p class="type-body text-muted mb-8">
      The requested route does not exist or has been moved to our new Node.js platform routes.
    </p>
    <a href="/" class="btn btn-primary btn-lg">Return to Home</a>
  </div>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>

