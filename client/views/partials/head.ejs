<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
<title><%= title ? title + '  -  NAKKO' : 'NAKKO  -  Connecting Workers with Opportunity' %></title>
<meta name="description" content="NAKKO is a cooperative-based gig platform connecting daily-wage workers with service opportunities. Fair work. Fair pay. Always." />
<meta property="og:title" content="<%= title || 'NAKKO' %>" />
<meta property="og:description" content="A cooperative gig platform for daily-wage workers, service seekers, and developers." />
<meta name="theme-color" content="#2d6a4f" />
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
<script>
  (function() {
    try {
      var saved = localStorage.getItem('nakko-theme');
      var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      var theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    } catch (e) {}
  })();
</script>
<link rel="stylesheet" href="/css/main.css" />
<link rel="stylesheet" href="/css/responsive.css" />
