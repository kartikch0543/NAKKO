<!-- ===== RESPONSIVE DASHBOARD HEADER ===== -->
<header class="dash-header">
  <div class="flex items-center gap-3">
    <!-- Mobile Sidebar Drawer Toggle Button -->
    <button type="button" class="mobile-dash-toggle" aria-label="Open navigation sidebar">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <a href="/" class="nav-logo" style="font-size:1.15rem;">
      <div class="nav-logo-icon" style="width:30px;height:30px;font-size:0.8125rem;">N</div>
      <span class="dash-header-title-text">NAKKO</span>
    </a>
    <span class="badge <%= roleBadgeClass || 'badge-blue' %>"><%= roleBadgeText || 'Dashboard' %></span>
  </div>

  <div class="flex items-center gap-3">
    <% if (locals.showAvailabilityToggle) { %>
      <div class="availability-toggle" style="padding:0.35rem 0.75rem; border:1px solid var(--border-color); background:var(--bg-surface); border-radius:var(--radius-full); display:flex; align-items:center; gap:0.5rem;">
        <label class="toggle" id="availToggle" style="width:38px;height:22px;">
          <input type="checkbox" id="workerOnlineCheckbox" <%= workerOnline ? 'checked' : '' %> onchange="toggleWorkerStatus(this)" />
          <span class="toggle-slider"></span>
        </label>
        <span class="availability-label" id="availLabel" style="font-size:0.8125rem; font-weight:600; color:var(--text-primary);"><%= workerOnline ? '🟢 Available' : '🔴 Offline' %></span>
      </div>
    <% } %>

    <!-- Theme Switcher Toggle -->
    <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" aria-label="Toggle dark/light mode" title="Toggle dark/light mode">
      <svg class="sun-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="moon-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>

    <button type="button" class="btn-icon btn" onclick="showToast('You have 2 new platform notifications!')" aria-label="Notifications" title="Notifications">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
    </button>

    <div class="flex items-center gap-2" style="cursor:pointer;" onclick="showSection('profile')">
      <div class="avatar-placeholder avatar-sm" style="background:<%= userAvatarBg || 'var(--color-user-bg)' %>; color:<%= userAvatarColor || 'var(--color-user)' %>; font-size:0.875rem; font-weight:700;">
        <%= userAvatarLetter || 'D' %>
      </div>
      <span class="type-body-sm font-medium dash-user-label" style="color:var(--text-primary);"><%= userName || 'User' %></span>
    </div>

    <a href="/login" class="btn btn-secondary btn-sm" style="padding:0.4rem 0.75rem; font-size:0.8125rem;" title="Sign out">
      <span>Sign out</span>
    </a>
  </div>
</header>
