<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { 
    title: '404 - Page Not Found', 
    description: 'The requested page could not be found on NAKKO platform.' 
  }) %>
  <style>
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-align: center;
    }
    .not-found-wrap {
      padding: 6rem 1.5rem;
      max-width: 560px;
      margin: auto;
    }
    .not-found-icon-wrap {
      width: 80px;
      height: 80px;
      margin: 0 auto 1.5rem;
      border-radius: var(--radius-full);
      background: rgba(45, 106, 79, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-accent);
    }
  </style>
</head>
<body>
  <%- include('partials/nav') %>

  <div class="not-found-wrap">
    <div class="not-found-icon-wrap">
      <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
    </div>
    <h1 class="type-h1 mb-2">404</h1>
    <h2 class="type-h2 mb-4">Page Not Found</h2>
    <p class="type-body text-muted mb-8">
      The page you are looking for does not exist or has been relocated. You can return to our homepage or access your dashboard.
    </p>
    <div class="flex items-center justify-center gap-4 flex-wrap">
      <a href="/" class="btn btn-primary btn-lg">Return to Home</a>
      <a href="/login" class="btn btn-secondary btn-lg">Sign In</a>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
