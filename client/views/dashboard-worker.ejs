<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Worker Dashboard' }) %>
  <style>
    .availability-toggle {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      padding: 0.4rem 0.875rem;
      background: var(--bg-surface);
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-full);
      color: var(--text-primary);
    }
    .availability-label { font-size: 0.8125rem; font-weight: 600; color: var(--text-primary); }

    .job-request {
      background: var(--bg-surface);
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-xl);
      padding: 1.5rem;
      margin-bottom: 1rem;
      transition: all var(--transition-base);
      position: relative;
      overflow: hidden;
      color: var(--text-primary);
    }
    .job-request::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 4px;
      background: var(--color-accent);
      border-radius: 4px 0 0 4px;
    }
    .job-request:hover { box-shadow: var(--shadow-md); border-color: var(--color-accent); }
    .job-request-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 0.875rem; }
    .job-request-service { font-weight: 700; font-size: 1.05rem; color: var(--text-primary); }
    .job-request-urgency { font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.125rem; }
    .job-request-details { display: flex; flex-wrap: wrap; gap: 0.875rem; margin-bottom: 1.25rem; }
    .job-detail { display: flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-muted); }
    .job-request-actions { display: flex; gap: 0.75rem; }

    .earnings-chart {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-xl);
      padding: 1.75rem;
      margin-bottom: 1.5rem;
      color: var(--text-primary);
    }
    .chart-bars {
      display: flex;
      align-items: flex-end;
      gap: 0.5rem;
      height: 100px;
      margin-top: 1rem;
    }
    .chart-bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 0.375rem; }
    .chart-bar {
      width: 100%;
      border-radius: 4px 4px 0 0;
      background: var(--color-accent-light);
      border: 1px solid var(--border-color);
      transition: all var(--transition-base);
      cursor: pointer;
    }
    .chart-bar:hover, .chart-bar.today { background: var(--color-accent); }
    .chart-label { font-size: 0.6875rem; color: var(--text-muted); text-align: center; }

    .skill-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .skill-tag {
      padding: 0.3rem 0.85rem;
      background: var(--color-accent-muted);
      color: var(--color-accent);
      border-radius: var(--radius-full);
      font-size: 0.8125rem;
      font-weight: 600;
      border: 1px solid var(--border-color);
    }
    .rating-stars { color: #f59e0b; font-size: 1rem; letter-spacing: 2px; }
  </style>
</head>
<body>

  <!-- Dashboard Header with Worker Availability Toggle -->
  <%- include('partials/dash-header', {
    roleBadgeClass: 'badge-green',
    roleBadgeText: 'Worker',
    userName: (locals.worker && worker.name) ? worker.name.split(' ')[0] : 'Ramesh',
    userAvatarLetter: (locals.worker && worker.name) ? worker.name.charAt(0) : 'R',
    userAvatarBg: 'var(--color-worker-bg)',
    userAvatarColor: 'var(--color-worker)',
    showAvailabilityToggle: true,
    workerOnline: (locals.worker && typeof worker.isAvailable !== 'undefined') ? worker.isAvailable : true
  }) %>

  <!-- Mobile Drawer Backdrop -->
  <div class="sidebar-backdrop" onclick="document.querySelector('.sidebar').classList.remove('mobile-open'); this.classList.remove('active');"></div>

  <div class="dashboard-layout">
    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar" role="navigation" aria-label="Sidebar Navigation">
      <div style="padding:1rem 0 0.5rem 1rem; display:flex; align-items:center; justify-content:space-between;" class="mobile-dash-toggle">
        <span class="type-body-sm font-semibold">Worker Navigation</span>
        <button type="button" onclick="document.querySelector('.sidebar').classList.remove('mobile-open'); document.querySelector('.sidebar-backdrop').classList.remove('active');" style="font-size:1.25rem; padding:0.25rem 0.5rem; color:var(--text-muted);"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
      </div>

      <div class="sidebar-section-label">Work</div>
      <div class="sidebar-item active" onclick="showSection('home')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span>Dashboard</span>
      </div>
      <div class="sidebar-item" onclick="showSection('jobs')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>Job Requests</span>
        <span class="sidebar-badge badge-orange">2</span>
      </div>
      <div class="sidebar-item" onclick="showSection('active')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>Active Job</span>
        <span class="sidebar-badge badge-green">Live</span>
      </div>

      <div class="sidebar-section-label">Finance & Profile</div>
      <div class="sidebar-item" onclick="showSection('earnings')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <span>Earnings</span>
      </div>
      <div class="sidebar-item" onclick="showSection('history')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        <span>Job History</span>
      </div>
      <div class="sidebar-item" onclick="showSection('ratings')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>Ratings (4.9 / 5.0)</span>
      </div>
      <div class="sidebar-item" onclick="showSection('profile')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>My Trade Profile</span>
      </div>

      <div style="margin-top:auto; padding:1.25rem 0.5rem 0.5rem;">
        <div class="card card-flat" style="padding:1rem; font-size:0.8125rem;">
          <div class="font-semibold text-foreground mb-1">Direct Payout</div>
          <div class="text-muted">₹1,250 earned today auto-transfers to bank at midnight.</div>
        </div>
      </div>
    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="dashboard-content">

      <!-- SECTION: HOME -->
      <div id="section-home">
        <div class="dash-greeting">
          <div class="dash-greeting-time" id="greetingTime2">Good day</div>
          <h1 class="dash-greeting-name">Namaste, <%= (locals.worker && worker.name) ? worker.name : 'Ramesh Kumar' %></h1>
          <p class="type-body-sm text-muted">You are <strong>Online</strong> and eligible for nearby plumbing & repair bookings.</p>
        </div>

        <!-- Quick Stats -->
        <div class="quick-stats">
          <div class="quick-stat-card">
            <div class="quick-stat-icon" style="background:var(--color-worker-bg); color:var(--color-worker);"></div>
            <div class="quick-stat-info">
              <div class="quick-stat-val">₹<%= (locals.worker && worker.earningsToday) ? worker.earningsToday : '1,250' %></div>
              <div class="quick-stat-label">Today's Earnings</div>
            </div>
          </div>
          <div class="quick-stat-card">
            <div class="quick-stat-icon" style="background:var(--color-user-bg); color:var(--color-user);"></div>
            <div class="quick-stat-info">
              <div class="quick-stat-val">₹<%= (locals.worker && worker.earningsThisMonth) ? worker.earningsThisMonth.toLocaleString() : '18,450' %></div>
              <div class="quick-stat-label">This Month</div>
            </div>
          </div>
          <div class="quick-stat-card">
            <div class="quick-stat-icon" style="background:var(--color-warning-bg); color:var(--color-warning);"></div>
            <div class="quick-stat-info">
              <div class="quick-stat-val">1</div>
              <div class="quick-stat-label">Active Job</div>
            </div>
          </div>
          <div class="quick-stat-card">
            <div class="quick-stat-icon" style="background:var(--color-dev-bg); color:var(--color-dev);"></div>
            <div class="quick-stat-info">
              <div class="quick-stat-val"><%= (locals.worker && worker.rating) ? worker.rating : '4.9' %></div>
              <div class="quick-stat-label">Rating (<%= (locals.worker && worker.reviewsCount) ? worker.reviewsCount : '284' %> reviews)</div>
            </div>
          </div>
        </div>

        <!-- Current Active Job Card -->
        <div class="card mb-8" style="border-left: 4px solid var(--color-success); padding:1.5rem;">
          <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <span class="status-dot status-dot-green"></span>
              <span class="type-label font-bold text-accent">CURRENT ASSIGNED JOB</span>
            </div>
            <span class="badge badge-green">In Progress</span>
          </div>
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
              <h3 class="type-h3 mb-1"> Plumbing  -  Sink Leak Repair</h3>
              <p class="type-body-sm text-muted">Customer: <strong>Divyanshu Sharma</strong> · Block 4, Sector 12, Noida</p>
              <p class="type-body-xs text-subtle mt-1">Payout: ₹450 · Held in Escrow</p>
            </div>
            <div class="flex gap-2">
              <button class="btn btn-primary btn-sm" onclick="showSection('active')">View Job Details & Complete →</button>
            </div>
          </div>
        </div>

        <!-- Earnings Chart Visual -->
        <div class="earnings-chart">
          <div class="flex items-center justify-between">
            <div>
              <div class="type-body-sm text-muted font-medium">Weekly Income Overview</div>
              <div class="type-h2" style="font-family:var(--font-display);">₹8,650</div>
            </div>
            <span class="badge badge-green">+18% vs last week</span>
          </div>
          <div class="chart-bars">
            <div class="chart-bar-wrap"><div class="chart-bar" style="height:45%;"></div><div class="chart-label">Mon</div></div>
            <div class="chart-bar-wrap"><div class="chart-bar" style="height:70%;"></div><div class="chart-label">Tue</div></div>
            <div class="chart-bar-wrap"><div class="chart-bar" style="height:35%;"></div><div class="chart-label">Wed</div></div>
            <div class="chart-bar-wrap"><div class="chart-bar" style="height:85%;"></div><div class="chart-label">Thu</div></div>
            <div class="chart-bar-wrap"><div class="chart-bar" style="height:60%;"></div><div class="chart-label">Fri</div></div>
            <div class="chart-bar-wrap"><div class="chart-bar" style="height:95%;"></div><div class="chart-label">Sat</div></div>
            <div class="chart-bar-wrap"><div class="chart-bar today" style="height:75%;"></div><div class="chart-label" style="font-weight:700; color:var(--color-accent);">Sun (Today)</div></div>
          </div>
        </div>

        <!-- New Nearby Job Requests -->
        <div class="flex items-center justify-between mb-4">
          <h2 class="type-h3">Incoming Job Requests (Nearby)</h2>
          <span class="type-body-xs text-muted">Cooperative Allocation Engine</span>
        </div>

        <div class="job-request">
          <div class="job-request-header">
            <div>
              <div class="job-request-service">Bathroom Shower & Tap Fixture Fitting</div>
              <div class="job-request-urgency"> Urgent · Required within 45 mins</div>
            </div>
            <span class="badge badge-green">₹550</span>
          </div>
          <div class="job-request-details">
            <div class="job-detail"> Sector 18, Noida (1.8 km)</div>
            <div class="job-detail"> Ananya Verma</div>
            <div class="job-detail"> Starts ~3:30 PM</div>
          </div>
          <div class="job-request-actions">
            <button class="btn btn-primary btn-sm" onclick="acceptJob(this, 'Bathroom Shower & Tap Fixture Fitting')">Accept Job</button>
            <button class="btn btn-secondary btn-sm" onclick="declineJob(this, 'Bathroom Shower & Tap Fixture Fitting')">Decline</button>
          </div>
        </div>

        <div class="job-request">
          <div class="job-request-header">
            <div>
              <div class="job-request-service">Water Tank Valve Replacement</div>
              <div class="job-request-urgency">Normal · Scheduled for tomorrow morning</div>
            </div>
            <span class="badge badge-green">₹700</span>
          </div>
          <div class="job-request-details">
            <div class="job-detail"> Sector 22, Noida (2.4 km)</div>
            <div class="job-detail"> Rohit Kapoor</div>
            <div class="job-detail"> Tomorrow, 10:00 AM</div>
          </div>
          <div class="job-request-actions">
            <button class="btn btn-primary btn-sm" onclick="acceptJob(this, 'Water Tank Valve Replacement')">Accept Job</button>
            <button class="btn btn-secondary btn-sm" onclick="declineJob(this, 'Water Tank Valve Replacement')">Decline</button>
          </div>
        </div>
      </div>

      <!-- SECTION: JOBS -->
      <div id="section-jobs" style="display:none;">
        <div class="dash-greeting">
          <h1 class="dash-greeting-name">Available Job Requests</h1>
          <p class="type-body-sm text-muted">Showing requests within 5 km of your location</p>
        </div>
        <div class="tabs mb-6">
          <div class="tab-item active" onclick="filterJobs('all', this)">All (4)</div>
          <div class="tab-item" onclick="filterJobs('urgent', this)">Urgent (2)</div>
          <div class="tab-item" onclick="filterJobs('highpay', this)">High Pay (₹600+)</div>
        </div>
        <div class="job-request">
          <div class="job-request-header">
            <div><div class="job-request-service">Kitchen Sink Pipe Replacement</div><div class="job-request-urgency"> Urgent</div></div>
            <span class="badge badge-green">₹450</span>
          </div>
          <div class="job-request-details"><div class="job-detail"> Sector 12 (0.9 km)</div><div class="job-detail"> Divyanshu S.</div></div>
          <div class="job-request-actions"><button class="btn btn-primary btn-sm" onclick="acceptJob(this, 'Kitchen Sink Pipe')">Accept</button><button class="btn btn-secondary btn-sm" onclick="declineJob(this, 'Kitchen Sink Pipe')">Decline</button></div>
        </div>
        <div class="job-request">
          <div class="job-request-header">
            <div><div class="job-request-service">Bathroom Drain Clog Clearing</div><div class="job-request-urgency">Normal</div></div>
            <span class="badge badge-green">₹400</span>
          </div>
          <div class="job-request-details"><div class="job-detail"> Sector 15 (1.5 km)</div><div class="job-detail"> Meera Sen</div></div>
          <div class="job-request-actions"><button class="btn btn-primary btn-sm" onclick="acceptJob(this, 'Bathroom Drain Clog')">Accept</button><button class="btn btn-secondary btn-sm" onclick="declineJob(this, 'Bathroom Drain Clog')">Decline</button></div>
        </div>
      </div>

      <!-- SECTION: ACTIVE -->
      <div id="section-active" style="display:none;">
        <div class="dash-greeting">
          <h1 class="dash-greeting-name">Active Assigned Job</h1>
          <p class="type-body-sm text-muted">Job ID: #NK-0042 · Plumbing Service</p>
        </div>
        <div class="card p-6 mb-6">
          <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
            <div>
              <h2 class="type-h3">Customer: Divyanshu Sharma</h2>
              <p class="type-body-sm text-muted"> Block 4, Sector 12, Noida, UP · Arrived at location</p>
            </div>
            <button class="btn btn-secondary btn-sm" onclick="showToast('Calling +91 98765 43210...')"> Call Customer</button>
          </div>
          <div class="divider"></div>
          <div class="mb-4">
            <div class="type-body-sm font-semibold mb-1">Problem Description:</div>
            <p class="type-body-sm text-muted">"Kitchen sink pipe leaking water rapidly under counter. Needs washer replacement and joint sealing."</p>
          </div>
          <div class="flex items-center justify-between p-4 rounded-lg mb-6" style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-md);">
            <div><div class="type-body-xs text-muted">Agreed Payout</div><div class="type-h3 text-accent">₹450</div></div>
            <div><div class="type-body-xs text-muted">Payment Mode</div><div class="font-semibold type-body-sm">Escrow Protected</div></div>
            <div><div class="type-body-xs text-muted">Customer Rating</div><div class="font-semibold type-body-sm">4.9 / 5.0 (Safe User)</div></div>
          </div>
          <div class="flex gap-3 flex-wrap">
            <button class="btn btn-primary" onclick="markJobComplete()">
              Mark Job Completed & Request Payment Release
            </button>
            <button class="btn btn-secondary" onclick="showToast('Support ticket raised. Cooperative supervisor will assist.')">
              Report Issue
            </button>
          </div>
        </div>
      </div>

      <!-- SECTION: EARNINGS -->
      <div id="section-earnings" style="display:none;">
        <div class="dash-greeting"><h1 class="dash-greeting-name">Earnings & Payouts</h1></div>
        <div class="quick-stats mb-6">
          <div class="quick-stat-card"><div class="quick-stat-icon" style="background:var(--color-worker-bg); color:var(--color-worker);"></div><div class="quick-stat-info"><div class="quick-stat-val">₹18,450</div><div class="quick-stat-label">This Month</div></div></div>
          <div class="quick-stat-card"><div class="quick-stat-icon" style="background:var(--color-user-bg); color:var(--color-user);"></div><div class="quick-stat-info"><div class="quick-stat-val">₹1,250</div><div class="quick-stat-label">Ready for Payout</div></div></div>
          <div class="quick-stat-card"><div class="quick-stat-icon" style="background:var(--color-warning-bg); color:var(--color-warning);"></div><div class="quick-stat-info"><div class="quick-stat-val">₹1,42,800</div><div class="quick-stat-label">Lifetime Earned</div></div></div>
          <div class="quick-stat-card"><div class="quick-stat-icon" style="background:var(--color-dev-bg); color:var(--color-dev);"></div><div class="quick-stat-info"><div class="quick-stat-val">88%</div><div class="quick-stat-label">Worker Share</div></div></div>
        </div>
        <div class="card p-6">
          <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
            <h3 class="type-h3">Connected Bank Account</h3>
            <button class="btn btn-secondary btn-sm" onclick="showToast('Bank details verified')">Edit Bank Details</button>
          </div>
          <p class="type-body-sm text-muted mb-4">State Bank of India · A/C: ••••••••••4812 · IFSC: SBIN0001234</p>
          <button class="btn btn-primary" onclick="showToast('Payout of ₹1,250 initiated to your SBI bank account! ')">Instant Withdrawal (IMPS)</button>
        </div>
      </div>

      <!-- SECTION: HISTORY -->
      <div id="section-history" style="display:none;">
        <div class="dash-greeting"><h1 class="dash-greeting-name">Completed Jobs History</h1></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Job ID</th><th>Customer</th><th>Service</th><th>Date</th><th>Earnings</th><th>Rating</th></tr></thead>
            <tbody>
              <tr><td>#NK-0038</td><td>Priya Sharma</td><td>Bathroom Tap Fix</td><td>Oct 28</td><td>₹450</td><td>5.0 / 5.0</td></tr>
              <tr><td>#NK-0035</td><td>Rahul Gupta</td><td>Geyser Pipe Fit</td><td>Oct 26</td><td>₹550</td><td>5.0 / 5.0</td></tr>
              <tr><td>#NK-0031</td><td>Vikram Jain</td><td>Drain Pipe Unclog</td><td>Oct 24</td><td>₹400</td><td>5.0 / 5.0</td></tr>
              <tr><td>#NK-0027</td><td>Amit Singh</td><td>Main Valve Change</td><td>Oct 20</td><td>₹650</td><td>5.0 / 5.0</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- SECTION: PROFILE -->
      <div id="section-profile" style="display:none;">
        <div class="dash-greeting"><h1 class="dash-greeting-name">Worker Trade Profile</h1></div>
        <div class="grid-2">
          <div class="card p-6">
            <h3 class="type-h3 mb-4">Personal Details</h3>
            <form class="login-form" onsubmit="event.preventDefault(); showToast('Profile changes saved!')">
              <div class="form-group"><label class="form-label">Full name</label><input class="form-input" type="text" value="<%= (locals.worker && worker.name) ? worker.name : 'Ramesh Kumar' %>" /></div>
              <div class="form-group"><label class="form-label">Phone</label><input class="form-input" type="tel" value="<%= (locals.worker && worker.phone) ? worker.phone : '+91 91234 56789' %>" /></div>
              <div class="form-group"><label class="form-label">Operating City / Area</label><input class="form-input" type="text" value="<%= (locals.worker && worker.city) ? worker.city : 'Noida & Greater Noida, UP' %>" /></div>
              <button type="submit" class="btn btn-primary">Save Changes</button>
            </form>
          </div>
          <div class="card p-6">
            <h3 class="type-h3 mb-4">Skills & Trade Badges</h3>
            <div class="skill-tags mb-4">
              <span class="skill-tag">Plumbing</span>
              <span class="skill-tag">Pipe Fitting</span>
              <span class="skill-tag">Tap Repair</span>
              <span class="skill-tag">Water Tank</span>
              <span class="skill-tag">Drainage</span>
            </div>
            <div class="mb-4">
              <div class="flex items-center justify-between mb-2">
                <span class="form-label">Job Completion Reliability</span>
                <span class="font-semibold text-accent">98.4%</span>
              </div>
              <div class="progress-bar"><div class="progress-fill" style="width:98.4%;"></div></div>
            </div>
            <p class="type-body-xs text-muted">Aadhaar verified · Cooperative Member ID #NK-W101</p>
          </div>
        </div>
      </div>

      <!-- SECTION: RATINGS -->
      <div id="section-ratings" style="display:none;">
        <div class="dash-greeting"><h1 class="dash-greeting-name">Ratings & Reviews</h1></div>
        <div class="card p-6 mb-6" style="max-width:640px;">
          <div class="flex items-center gap-6">
            <div style="text-align:center;">
              <div style="font-family:var(--font-display); font-size:4rem; line-height:1; color:var(--text-primary);"><%= (locals.worker && worker.rating) ? worker.rating : '4.9' %></div>
              <div class="rating-stars">5.0 / 5.0</div>
              <div class="type-body-xs text-muted mt-1"><%= (locals.worker && worker.reviewsCount) ? worker.reviewsCount : '284' %> verified reviews</div>
            </div>
            <div style="flex:1;">
              <div class="flex items-center gap-2 mb-2"><span class="type-body-xs" style="width:20px;">5 / 5.0</span><div class="progress-bar flex-1"><div class="progress-fill" style="width:88%;"></div></div><span class="type-body-xs text-muted">250</span></div>
              <div class="flex items-center gap-2 mb-2"><span class="type-body-xs" style="width:20px;">4 / 5.0</span><div class="progress-bar flex-1"><div class="progress-fill" style="width:9%;"></div></div><span class="type-body-xs text-muted">26</span></div>
              <div class="flex items-center gap-2 mb-2"><span class="type-body-xs" style="width:20px;">3 / 5.0</span><div class="progress-bar flex-1"><div class="progress-fill" style="width:2%;"></div></div><span class="type-body-xs text-muted">6</span></div>
              <div class="flex items-center gap-2 mb-2"><span class="type-body-xs" style="width:20px;">2 / 5.0</span><div class="progress-bar flex-1"><div class="progress-fill" style="width:0.5%;"></div></div><span class="type-body-xs text-muted">2</span></div>
            </div>
          </div>
        </div>
        <div class="card p-5 mb-3">
          <div class="flex items-center justify-between mb-1"><span class="font-semibold type-body-sm">Priya Sharma</span><span class="rating-stars">5.0 / 5.0</span></div>
          <p class="type-body-sm text-muted">"Super fast and professional. Fixed the pipe leak in 30 minutes. Honest pricing!"</p>
          <div class="type-body-xs text-subtle mt-2">Nov 1, 2026</div>
        </div>
        <div class="card p-5 mb-3">
          <div class="flex items-center justify-between mb-1"><span class="font-semibold type-body-sm">Rahul Kumar</span><span class="rating-stars">5.0 / 5.0</span></div>
          <p class="type-body-sm text-muted">"Very skilled and honest. Did not overcharge for parts. Highly recommended."</p>
          <div class="type-body-xs text-subtle mt-2">Oct 30, 2026</div>
        </div>
      </div>

    </main>
  </div>

  <!-- Mobile Bottom Tab Navigation -->
  <%- include('partials/dash-mobile-nav', { role: 'worker' }) %>

  <script src="/js/services/apiClient.js"></script>
  <script src="/js/services/workerService.js"></script>
  <script src="/js/services/assignmentService.js"></script>
  <script src="/js/services/requestService.js"></script>
  <script src="/js/main.js"></script>
  <script>
    function showSection(id) {
      ['home', 'jobs', 'active', 'earnings', 'history', 'profile', 'ratings'].forEach(s => {
        const el = document.getElementById(`section-${s}`);
        if (el) el.style.display = s === id ? 'block' : 'none';
      });

      document.querySelectorAll('.sidebar-item').forEach(item => {
        const txt = item.textContent.trim().toLowerCase();
        item.classList.toggle('active',
          (id === 'home' && txt.includes('dashboard')) ||
          (id === 'jobs' && txt.includes('job request')) ||
          (id === 'active' && txt.includes('active job')) ||
          (id === 'earnings' && txt.includes('earnings')) ||
          (id === 'history' && txt.includes('job history')) ||
          (id === 'ratings' && txt.includes('ratings')) ||
          (id === 'profile' && txt.includes('trade profile'))
        );
      });

      syncMobileBottomNav(id);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function toggleWorkerStatus(checkbox) {
      const isOnline = checkbox.checked;
      const label = document.getElementById('availLabel');
      label.textContent = isOnline ? '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--color-success);margin-right:4px;"></span> Available' : '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--color-warning);margin-right:4px;"></span> Offline';

      try {
        await workerService.setAvailability('w-101', isOnline);
        showToast(isOnline ? 'You are now visible to nearby customers!' : 'You are now offline.');
      } catch (err) {
        showToast(isOnline ? 'You are now online.' : 'You are now offline.');
      }
    }

    async function acceptJob(btn, title) {
      btn.textContent = 'Accepted ';
      btn.classList.remove('btn-primary');
      btn.classList.add('btn-accent');
      btn.disabled = true;
      try {
        await assignmentService.acceptJob('NK-0043', 'w-101');
      } catch(e) {}
      showToast(`Job accepted: ${title}! Customer notified.`);
      setTimeout(() => showSection('active'), 900);
    }

    function declineJob(btn, title) {
      const card = btn.closest('.job-request');
      if (card) card.remove();
      showToast(`Declined: ${title}`);
    }

    async function markJobComplete() {
      try {
        await requestService.updateBookingStatus('NK-0042', 'completed');
      } catch(e) {}
      showToast('Job marked complete! Customer prompted to inspect and release payment.');
      setTimeout(() => showSection('home'), 1400);
    }

    function filterJobs(filter, tabEl) {
      document.querySelectorAll('.tabs .tab-item').forEach(t => t.classList.remove('active'));
      tabEl.classList.add('active');
      showToast(`Filtered: ${filter}`);
    }
  </script>
</body>
</html>
