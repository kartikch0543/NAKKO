              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION: API EXPLORER -->
      <div id="section-api" style="display:none;">
        <div class="dash-greeting">
          <h1 class="dash-greeting-name">REST API Documentation & Explorer</h1>
          <p class="type-body-sm text-muted">Interactive queries for testing backend API endpoints</p>
        </div>

        <div class="grid-2 mb-6">
          <div>
            <h3 class="type-h3 mb-3">Available Endpoints</h3>
            <div class="api-endpoint" onclick="runApiSample('GET', '/api/services')">
              <span class="method-badge method-get">GET</span>
              <span class="api-path">/api/services</span>
              <span class="type-body-xs text-muted">List gig categories</span>
            </div>
            <div class="api-endpoint" onclick="runApiSample('GET', '/api/workers')">
              <span class="method-badge method-get">GET</span>
              <span class="api-path">/api/workers</span>
              <span class="type-body-xs text-muted">Active workers list</span>
            </div>
            <div class="api-endpoint" onclick="runApiSample('GET', '/api/bookings')">
              <span class="method-badge method-get">GET</span>
              <span class="api-path">/api/bookings</span>
              <span class="type-body-xs text-muted">All active and past jobs</span>
            </div>
            <div class="api-endpoint" onclick="runApiSample('GET', '/api/dev/metrics')">
              <span class="method-badge method-get">GET</span>
              <span class="api-path">/api/dev/metrics</span>
              <span class="type-body-xs text-muted">Platform telemetry</span>
            </div>
            <div class="api-endpoint" onclick="runApiSample('GET', '/api/dev/logs')">
              <span class="method-badge method-get">GET</span>
              <span class="api-path">/api/dev/logs</span>
              <span class="type-body-xs text-muted">System logs stream</span>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="type-h3">Live Response Output</h3>
              <span class="badge badge-green" id="apiStatusBadge">200 OK</span>
            </div>
            <div class="code-block" id="apiResponseBlock" style="height:320px; overflow-y:auto;">
// Click any endpoint on the left to execute live against the backend
// Example: GET /api/services
{
  "status": "Ready",
  "engine": "Express.js",
  "version": "1.0.0"
}
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION: LOGS -->
      <div id="section-logs" style="display:none;">
        <div class="dash-greeting">
          <h1 class="dash-greeting-name">System Event Logs</h1>
          <p class="type-body-sm text-muted">Live logging from Express.js application middleware</p>
        </div>
        <div class="card p-6">
          <div class="tabs mb-4">
            <div class="tab-item active" onclick="filterLogs('ALL', this)">All</div>
            <div class="tab-item" onclick="filterLogs('INFO', this)">INFO</div>
            <div class="tab-item" onclick="filterLogs('WARN', this)">WARN</div>
            <div class="tab-item" onclick="filterLogs('ERROR', this)">ERROR</div>
          </div>
          <div class="code-block" id="logsDisplay" style="height:360px; overflow-y:auto; font-size:0.75rem;">
<%- (logs || []).map(function(l) {
  var color = l.level === 'ERROR' ? '#ef4444' : l.level === 'WARN' ? '#f59e0b' : '#22c55e';
  return '<span style="color:#64748b;">[' + l.timestamp + ']</span> <span style="color:' + color + '; font-weight:700;">' + l.level + '</span>  ' + l.message;
}).join('\n') %>
          </div>
        </div>
      </div>

      <!-- SECTION: USERS -->
