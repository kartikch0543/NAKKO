              </div>
              <div class="flex items-center gap-3">
                <span class="status-dot status-dot-green"></span>
                <span class="type-body-sm flex-1">Booking #NK-0042 created by Client Divyanshu</span>
                <span class="type-body-xs text-muted">4m ago</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="status-dot status-dot-green"></span>
                <span class="type-body-sm flex-1">Escrow payment ₹600 released to Sunita Devi</span>
                <span class="type-body-xs text-muted">14m ago</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="status-dot status-dot-amber"></span>
                <span class="type-body-sm flex-1">SMS provider retry dispatched for verification OTP</span>
