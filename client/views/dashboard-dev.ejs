<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { 
    title: 'Developer Portal', 
    description: 'System telemetry, REST API explorer, KYC verification, and operational logs for NAKKO platform.' 
  }) %>
  <style>
    .metric-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }
    .metric-label {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }
    .metric-value {
      font-family: var(--font-display);
      font-size: 2.25rem;
      line-height: 1;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
    }
    .metric-change {
      font-size: 0.8125rem;
      font-weight: 600;
    }
    .metric-change.up { color: var(--color-success); }
    .metric-change.down { color: var(--color-error); }

    .code-block {
      background: #0f172a;
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      font-family: 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
      font-size: 0.8125rem;
      line-height: 1.7;
      overflow-x: auto;
      color: #93c5fd;
      border: 1px solid var(--border-color);
      white-space: pre;
    }

    .method-badge {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      font-size: 0.6875rem;
      font-weight: 700;
      font-family: monospace;
    }
    .method-get { background: rgba(34, 197, 94, 0.15); color: #16a34a; }
    .method-post { background: rgba(59, 130, 246, 0.15); color: #2563eb; }
    .method-patch { background: rgba(245, 158, 11, 0.15); color: #d97706; }

    .api-endpoint {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.875rem 1.25rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-color);
      background: var(--bg-surface);
      margin-bottom: 0.625rem;
      font-size: 0.875rem;
      transition: all var(--transition-fast);
      cursor: pointer;
    }
    .api-endpoint:hover {
      border-color: var(--color-accent);
      box-shadow: var(--shadow-sm);
    }
    .api-path {
      font-family: monospace;
      color: var(--text-primary);
      font-size: 0.8125rem;
      flex: 1;
    }

    .status-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.875rem 0;
      border-bottom: 1px solid var(--border-color);
    }
    .status-row:last-child { border-bottom: none; }
  </style>
</head>
<body>

  <!-- Dashboard Header with Theme Toggle -->
  <%- include('partials/dash-header', {
    roleBadgeClass: 'badge-purple',
    roleBadgeText: 'Developer & Admin',
    userName: 'Admin Divyanshu',
    userAvatarLetter: 'A',
    userAvatarBg: 'var(--color-dev-bg)',
    userAvatarColor: 'var(--color-dev)'
  }) %>

  <!-- Mobile Drawer Backdrop -->
  <div class="sidebar-backdrop" onclick="document.querySelector('.sidebar').classList.remove('mobile-open'); this.classList.remove('active');"></div>

  <div class="dashboard-layout">
    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar" role="navigation" aria-label="Sidebar Navigation">
      <div style="padding:1rem 0 0.5rem 1rem; display:flex; align-items:center; justify-content:space-between;" class="mobile-dash-toggle">
        <span class="type-body-sm font-semibold">Dev Navigation</span>
        <button type="button" onclick="document.querySelector('.sidebar').classList.remove('mobile-open'); document.querySelector('.sidebar-backdrop').classList.remove('active');" style="font-size:1.25rem; padding:0.25rem 0.5rem; color:var(--text-muted); background:none; border:none; cursor:pointer;" aria-label="Close sidebar">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="sidebar-section-label">Monitoring</div>
      <div class="sidebar-item active" onclick="showSection('overview')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        <span>Overview</span>
      </div>
      <div class="sidebar-item" onclick="showSection('status')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        <span>System Status</span>
        <span class="sidebar-badge" style="background:var(--color-success); color:white;">99.9%</span>
      </div>
      <div class="sidebar-item" onclick="showSection('logs')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <span>Server Logs</span>
      </div>

      <div class="sidebar-section-label">Management</div>
      <div class="sidebar-item" onclick="showSection('users')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>User Accounts</span>
      </div>
      <div class="sidebar-item" onclick="showSection('workers')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        <span>Workers & KYC</span>
        <!-- Clean, fixed horizontal badge with explicit white-space nowrap and flex-shrink 0 -->
        <span class="sidebar-badge" style="background:#f59e0b; color:#ffffff; font-size:0.6875rem; font-weight:700; padding:0.2rem 0.55rem; border-radius:9999px; white-space:nowrap; flex-shrink:0;">3 New</span>
      </div>
      <div class="sidebar-item" onclick="showSection('bookings')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span>All Bookings</span>
      </div>

      <div class="sidebar-section-label">Developer Tools</div>
      <div class="sidebar-item" onclick="showSection('api')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <span>API Explorer</span>
      </div>
      <div class="sidebar-item" onclick="showSection('config')">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span>Platform Config</span>
      </div>

      <div style="margin-top:auto; padding:1.25rem 0.5rem 0.5rem;">
        <div class="card card-flat" style="padding:1rem; font-size:0.75rem; color:var(--text-muted);">
          <div class="font-semibold text-primary mb-1">Node.js Server v22.14</div>
          <div>Express v5.3 | Mongoose Connected</div>
        </div>
      </div>
    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="dashboard-content">

      <!-- SECTION: OVERVIEW -->
      <div id="section-overview">
        <div class="dash-greeting">
          <div class="dash-greeting-time" style="color:var(--color-dev);">Node.js Backend Active | Region ap-south-1</div>
          <h1 class="dash-greeting-name">Platform Performance</h1>
        </div>

        <!-- Metric Cards -->
        <div class="grid-4 mb-8">
          <div class="metric-card">
            <div class="metric-label">Monthly Gross Vol</div>
            <div class="metric-value">₹4.82L</div>
            <div class="metric-change up">+24.3% vs last month</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Registered Workers</div>
            <div class="metric-value">12,480</div>
            <div class="metric-change up">+340 this week</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Job Completion</div>
            <div class="metric-value">98.4%</div>
            <div class="metric-change up">+0.3% quality index</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">API Latency (p99)</div>
            <div class="metric-value">42ms</div>
            <div class="metric-change up">Operational & Fast</div>
          </div>
        </div>

        <!-- System Status Summary -->
        <div class="grid-2 mb-8">
          <div class="card p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="type-h3">Platform Health</h3>
              <span class="badge badge-green">All Systems Up</span>
            </div>
            <div class="status-row"><span class="type-body-sm font-medium">Express.js API Router</span><span class="badge badge-green">Operational (99.98%)</span></div>
            <div class="status-row"><span class="type-body-sm font-medium">Worker Allocation Engine</span><span class="badge badge-green">Operational</span></div>
            <div class="status-row"><span class="type-body-sm font-medium">Payment Escrow System</span><span class="badge badge-green">Operational</span></div>
            <div class="status-row"><span class="type-body-sm font-medium">SMS Notification Gateway</span><span class="badge badge-orange">Latency (320ms)</span></div>
          </div>

          <div class="card p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="type-h3">Live Activity Feed</h3>
              <button class="btn btn-secondary btn-sm" onclick="showSection('logs')">View all logs &rarr;</button>
            </div>
            <div style="display:flex; flex-direction:column; gap:0.875rem;">
              <div class="flex items-center gap-3">
                <span class="status-dot status-dot-green"></span>
                <span class="type-body-sm flex-1">Worker Ramesh Kumar accepted job #NK-0042</span>
