      <!-- SECTION: BOOKINGS -->
      <div id="section-bookings" style="display:none;">
        <div class="dash-greeting"><h1 class="dash-greeting-name">Platform Bookings Oversight</h1></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Booking ID</th><th>Client</th><th>Worker</th><th>Service</th><th>Amount</th><th>Status</th></tr></thead>
            <tbody>
              <tr><td>#NK-0042</td><td>Divyanshu S.</td><td>Ramesh Kumar</td><td>Plumbing</td><td>₹450</td><td><span class="badge badge-green">In Progress</span></td></tr>
              <tr><td>#NK-0041</td><td>Priya Sharma</td><td>Sunita Devi</td><td>Cleaning</td><td>₹600</td><td><span class="badge badge-green">Completed</span></td></tr>
              <tr><td>#NK-0040</td><td>Divyanshu S.</td><td>Mohan Yadav</td><td>Electrical</td><td>₹380</td><td><span class="badge badge-green">Completed</span></td></tr>
              <tr><td>#NK-0039</td><td>Aditya Menon</td><td>Lakshmi Narayan</td><td>Gardening</td><td>₹350</td><td><span class="badge badge-green">Completed</span></td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- SECTION: STATUS -->
      <div id="section-status" style="display:none;">
        <div class="dash-greeting"><h1 class="dash-greeting-name">Infrastructure & Systems Status</h1></div>
        <div class="card p-6 mb-6">
          <div class="status-row"><span class="font-medium">Express.js Web Server (port 3000)</span><span class="badge badge-green">Healthy</span></div>
          <div class="status-row"><span class="font-medium">Data Storage (In-Memory / MongoDB Cluster)</span><span class="badge badge-green">Connected</span></div>
          <div class="status-row"><span class="font-medium">Payment Gateway (Razorpay UPI Escrow)</span><span class="badge badge-green">Ready</span></div>
          <div class="status-row"><span class="font-medium">Geolocation Matrix Engine</span><span class="badge badge-green">Operational</span></div>
        </div>
      </div>

      <!-- SECTION: CONFIG -->
      <div id="section-config" style="display:none;">
        <div class="dash-greeting"><h1 class="dash-greeting-name">Platform Configuration</h1></div>
        <div class="grid-2">
          <div class="card p-6">
            <h3 class="type-h3 mb-4">Platform Flags</h3>
            <div style="display:flex; flex-direction:column; gap:1.25rem;">
              <div class="flex items-center justify-between">
                <div><div class="type-body-sm font-semibold">Maintenance Mode</div><div class="type-body-xs text-muted">Temporarily close public access</div></div>
                <label class="toggle"><input type="checkbox" onchange="showToast('Maintenance mode toggled')" /><span class="toggle-slider"></span></label>
              </div>
              <div class="flex items-center justify-between">
                <div><div class="type-body-sm font-semibold">New Worker Registrations</div><div class="type-body-xs text-muted">Allow new workers to enroll</div></div>
                <label class="toggle"><input type="checkbox" checked onchange="showToast('Worker registrations updated')" /><span class="toggle-slider"></span></label>
              </div>
              <div class="flex items-center justify-between">
                <div><div class="type-body-sm font-semibold">Instant KYC Auto-Verification</div><div class="type-body-xs text-muted">Verify Aadhaar via DigiLocker API</div></div>
                <label class="toggle"><input type="checkbox" checked onchange="showToast('Auto-KYC toggled')" /><span class="toggle-slider"></span></label>
              </div>
            </div>
          </div>
          <div class="card p-6">
            <h3 class="type-h3 mb-4">Economics & Payout Rules</h3>
            <div class="login-form">
              <div class="form-group"><label class="form-label">Platform Cooperative Fee (%)</label><input class="form-input" id="cfgFee" type="number" value="12" /></div>
              <div class="form-group"><label class="form-label">Worker Payout Cycle (Hours)</label><input class="form-input" id="cfgPayout" type="number" value="24" /></div>
              <div class="form-group"><label class="form-label">Min Booking Escrow (₹)</label><input class="form-input" id="cfgMin" type="number" value="100" /></div>
              <button type="button" class="btn btn-primary" onclick="savePlatformConfig()">Save Platform Configuration</button>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- Mobile Bottom Tab Navigation -->
  <%- include('partials/dash-mobile-nav', { role: 'dev', themeClass: 'dev-theme-nav' }) %>

  <!-- Service Layer & Main JS -->
  <script src="/js/services/apiClient.js"></script>
  <script src="/js/main.js"></script>
  <script>
    function showSection(id) {
      ['overview', 'status', 'logs', 'users', 'workers', 'bookings', 'api', 'config'].forEach(s => {
        const el = document.getElementById(`section-${s}`);
        if (el) el.style.display = s === id ? 'block' : 'none';
      });

      document.querySelectorAll('.sidebar-item').forEach(item => {
        const txt = item.textContent.trim().toLowerCase();
        item.classList.toggle('active',
          (id === 'overview' && txt.includes('overview')) ||
          (id === 'status' && txt.includes('status')) ||
          (id === 'logs' && txt.includes('logs')) ||
          (id === 'users' && txt.includes('user accounts')) ||
          (id === 'workers' && txt.includes('workers')) ||
          (id === 'bookings' && txt.includes('all bookings')) ||
          (id === 'api' && txt.includes('api explorer')) ||
          (id === 'config' && txt.includes('config'))
        );
      });

      syncMobileBottomNav(id);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function runApiSample(method, path) {
      const block = document.getElementById('apiResponseBlock');
      const badge = document.getElementById('apiStatusBadge');
      block.textContent = 'Querying endpoint...';
      try {
        let result;
        if (window.apiClient) {
          result = await apiClient.request(path, { method });
          badge.textContent = '200 OK';
          badge.className = 'badge badge-green';
        } else {
          const res = await fetch(path, { method });
          result = await res.json();
          badge.textContent = `${res.status} ${res.statusText || 'OK'}`;
          badge.className = res.ok ? 'badge badge-green' : 'badge badge-red';
        }
        block.textContent = JSON.stringify(result, null, 2);
      } catch (err) {
        block.textContent = `// Error fetching ${path}: ${err.message}`;
        badge.textContent = 'Error';
        badge.className = 'badge badge-red';
      }
    }

    async function savePlatformConfig() {
      const commission = document.getElementById('cfgFee').value;
      const payout = document.getElementById('cfgPayout').value;
      const min = document.getElementById('cfgMin').value;

      try {
        if (window.apiClient) {
          await apiClient.post('/dev/config', {
            commissionPercent: commission,
            payoutWindowHours: payout,
            minBookingAmount: min
          });
        } else {
          await fetch('/api/dev/config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ commissionPercent: commission, payoutWindowHours: payout, minBookingAmount: min })
          });
        }
        showToast('Platform configuration saved.');
      } catch (err) {
        showToast('Configuration updated locally.');
      }
    }

    async function filterLogs(level, tabEl) {
      document.querySelectorAll('.tabs .tab-item').forEach(t => t.classList.remove('active'));
      tabEl.classList.add('active');
      try {
        let data;
        if (window.apiClient) {
          data = await apiClient.get(`/dev/logs?level=${level}`);
        } else {
          const res = await fetch(`/api/dev/logs?level=${level}`);
          data = await res.json();
        }
        const display = document.getElementById('logsDisplay');
        const logs = data.data || [];
        display.innerHTML = logs.map(l => {
          const color = l.level === 'ERROR' ? '#ef4444' : l.level === 'WARN' ? '#f59e0b' : '#22c55e';
          return `<span style="color:#64748b;">[${l.timestamp}]</span> <span style="color:${color}; font-weight:700;">${l.level}</span>  ${l.message}`;
        }).join('\n');
      } catch (err) {
        showToast('Logs filtered');
      }
    }
  </script>
</body>
</html>
