# NAKKO Backend Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/nakko

# JWT Secret & Expiry
JWT_SECRET=nakko_super_secure_jwt_secret_change_in_production_2026!
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Matching Algorithm Configuration
MAX_SEARCH_RADIUS_KM=15
MATCH_WEIGHT_PROXIMITY=0.40
MATCH_WEIGHT_WORKLOAD=0.30
MATCH_WEIGHT_RATING=0.15
MATCH_WEIGHT_COOPERATIVE=0.15

# Payment Gateway (Razorpay Sandbox / Test Mode)
RAZORPAY_KEY_ID=rzp_test_nakko_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_nakko_mock_secret
PAYMENT_WEBHOOK_SECRET=nakko_webhook_secret_sandbox

# Google Maps Distance Matrix API (Optional - has internal Haversine fallback)
GOOGLE_MAPS_API_KEY=

# Government Welfare API Simulation
WELFARE_API_SIMULATION_MODE=true

